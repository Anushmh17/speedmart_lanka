# Firebase config files — contain API keys, never commit
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
/tools/fcm_server_example/serviceAccountKey.json
lib/firebase_options.dart

# Build outputs — contain compiled secrets, never commit
/build/
functions/lib/
functions/node_modules/
