{
  "name": "speedmart-functions",
  "scripts": {
    "build": "tsc",
    "backfill:customer-proposals": "npm run build && node lib/scripts/backfill_customer_proposals.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "firebase-functions-test": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "private": true
}
