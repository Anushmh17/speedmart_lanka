rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/admins/profiles/$(uid()));
    }

    function isVendor() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/vendors/profiles/$(uid()));
    }

    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }

    function isChatParticipant(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return uid() == chat.customerId || uid() == chat.vendorId;
    }

    // ── User Profiles ─────────────────────────────────────────────────────────

    match /users/customers/profiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if true; // needed for phone/email lookup during login before auth
      allow create: if isSignedIn();
      allow update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    match /users/vendors/profiles/{userId} {
      allow get: if isOwner(userId) || isAdmin() || isVendor();
      allow list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /users/admins/profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if false;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    // ── Categories ────────────────────────────────────────────────────────────

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Shopping Requests ─────────────────────────────────────────────────────

    match /requests/{requestId} {
      allow get: if isSignedIn() && (
        resource.data.customerId == uid() ||
        isVendor() ||
        isAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.customerId == uid();
      allow update: if isSignedIn() &&
        (resource.data.customerId == uid() || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Proposals ─────────────────────────────────────────────────────────────

    match /proposals/{proposalId} {
      allow get: if isSignedIn() && (
        resource.data.vendorId == uid() ||
        resource.data.customerId == uid() ||
        isAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isVendor() &&
        request.resource.data.vendorId == uid();
      allow update: if isSignedIn() && (
        resource.data.vendorId == uid() ||
        resource.data.customerId == uid() ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Orders ────────────────────────────────────────────────────────────────

    match /orders/{orderId} {
      allow get: if isSignedIn() && (
        resource.data.customerId == uid() ||
        resource.data.vendorId == uid() ||
        isAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.customerId == uid();
      allow update: if isSignedIn() && (
        resource.data.customerId == uid() ||
        resource.data.vendorId == uid() ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Payments ──────────────────────────────────────────────────────────────

    match /payments/{paymentId} {
      allow get: if isSignedIn() && (
        resource.data.customerId == uid() ||
        resource.data.vendorId == uid() ||
        isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.customerId == uid();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Notifications ─────────────────────────────────────────────────────────

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && resource.data.userId == uid();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if isSignedIn() && resource.data.userId == uid();
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    // ── Reviews ───────────────────────────────────────────────────────────────

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.customerId == uid();
      allow update: if isSignedIn() &&
        (resource.data.customerId == uid() || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Delivery Areas ────────────────────────────────────────────────────────

    match /delivery_areas/{areaId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Activity Logs ─────────────────────────────────────────────────────────

    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    // ── Chat ──────────────────────────────────────────────────────────────────

    match /chats/{chatId} {
      allow read: if isSignedIn() && (
        resource.data.customerId == uid() ||
        resource.data.vendorId == uid() ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.customerId == uid() ||
        request.resource.data.vendorId == uid()
      );
      allow update: if isSignedIn() && (
        resource.data.customerId == uid() ||
        resource.data.vendorId == uid()
      );
      allow delete: if isAdmin();
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isSignedIn() && (isChatParticipant(chatId) || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.senderId == uid() &&
        isChatParticipant(chatId);
      allow update, delete: if false;
    }

    // ── Deny everything else ──────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
