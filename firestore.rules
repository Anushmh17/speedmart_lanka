rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/admins/profiles/$(uid()));
    }

    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }

    // ── User Profiles ─────────────────────────────────────────────────────────

    match /users/customers/profiles/{userId} {
      // Unauthenticated reads allowed — needed for phone/email existence check during OTP login
      // Limit to single-doc reads/queries only — blocks full collection dumps
      allow read: if request.query == null || request.query.limit <= 1;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /users/vendors/profiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /users/admins/profiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // ── Shopping Requests ─────────────────────────────────────────────────────

    match /requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.customerId == uid();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ── Proposals ─────────────────────────────────────────────────────────────

    match /proposals/{proposalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ── Orders ────────────────────────────────────────────────────────────────

    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ── Payments ─────────────────────────────────────────────────────────────

    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ── Notifications ─────────────────────────────────────────────────────────

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ── Reviews ──────────────────────────────────────────────────────────────

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ── Delivery Areas ────────────────────────────────────────────────────────

    match /delivery_areas/{areaId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── Activity Logs ─────────────────────────────────────────────────────────

    match /activity_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ── Chat ─────────────────────────────────────────────────────────────────

    match /chats/{chatId} {
      allow read, write: if isSignedIn();
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.senderId == uid();
      allow update, delete: if false;
    }

    // ── Deny everything else ──────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
