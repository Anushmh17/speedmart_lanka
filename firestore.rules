rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/admins/profiles/$(uid()));
    }

    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }

    // ── User Profiles ─────────────────────────────────────────────────────────

    match /users/customers/profiles/{userId} {
      // Only authenticated users can read — unauthenticated OTP existence checks
      // should be handled via a Cloud Function, not direct Firestore reads.
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && uid() == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /users/vendors/profiles/{userId} {
      // Only the vendor themselves or an admin can read the full profile.
      // Customers should never see vendor NIC, bank details, etc.
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /users/admins/profiles/{userId} {
      // Admin accounts must only be created via Firebase Console or a trusted Cloud Function.
      allow read: if isOwner(userId) || isAdmin();
      allow create: if false;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    // ── Shopping Requests ─────────────────────────────────────────────────────

    match /requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.customerId == uid();
      allow update: if isSignedIn() &&
        (resource.data.customerId == uid() || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Proposals ─────────────────────────────────────────────────────────────

    match /proposals/{proposalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        (resource.data.vendorId == uid() ||
         resource.data.customerId == uid() ||
         isAdmin());
      allow delete: if isAdmin();
    }

    // ── Orders ────────────────────────────────────────────────────────────────

    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.customerId == uid() ||
         resource.data.vendorId == uid() ||
         isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        (resource.data.customerId == uid() ||
         resource.data.vendorId == uid() ||
         isAdmin());
      allow delete: if isAdmin();
    }

    // ── Payments ─────────────────────────────────────────────────────────────

    match /payments/{paymentId} {
      allow read: if isSignedIn() &&
        (resource.data.customerId == uid() ||
         resource.data.vendorId == uid() ||
         isAdmin());
      allow create: if isSignedIn();
      // Only admins can update payment records to prevent tampering
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Notifications ─────────────────────────────────────────────────────────

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == uid();
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    // ── Reviews ──────────────────────────────────────────────────────────────

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        (resource.data.customerId == uid() || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Delivery Areas ────────────────────────────────────────────────────────

    match /delivery_areas/{areaId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Activity Logs ─────────────────────────────────────────────────────────

    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ── Chat ─────────────────────────────────────────────────────────────────

    match /chats/{chatId} {
      allow read, write: if isSignedIn();
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.senderId == uid();
      allow update, delete: if false;
    }

    // ── Deny everything else ──────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
